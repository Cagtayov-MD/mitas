{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mitas.local/schemas/text_event/v1.0.0",
  "title": "MITAS OCR text_event format v1",
  "description": "Pipeline output schema. Generic 'text event' format — kart, scroll, KJ, intertitle hepsi aynı format. Faz 1 (madde 1+8).",
  "type": "object",
  "required": ["schema_version", "video_id", "events", "summary"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "video_id": {
      "type": "string",
      "description": "Manifest item id"
    },
    "source_path": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/definitions/TextEvent"}
    },
    "summary": {
      "type": "object",
      "required": ["engine", "version", "total_events", "by_type", "runtime_sec"],
      "properties": {
        "engine": {"type": "string", "examples": ["k_box_track_unified"]},
        "version": {"type": "string"},
        "total_events": {"type": "integer", "minimum": 0},
        "by_type": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        },
        "runtime_sec": {"type": "number", "minimum": 0},
        "low_confidence_count": {"type": "integer", "minimum": 0},
        "fallback_used": {"type": "boolean", "default": false},
        "fallback_reason": {"type": ["string", "null"]}
      }
    }
  },
  "definitions": {
    "TextEvent": {
      "type": "object",
      "required": ["event_id", "start_sec", "end_sec", "type", "type_reason", "text", "confidence"],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^evt_[0-9]{4,}$",
          "description": "evt_0001, evt_0002, ..."
        },
        "start_sec": {"type": "number", "minimum": 0},
        "end_sec": {"type": "number", "minimum": 0},
        "duration_sec": {"type": "number", "minimum": 0},
        "type": {
          "type": "string",
          "enum": ["scroll_credit", "card", "intertitle", "kj", "scene_text"],
          "description": "Event sınıfı. V1'de film modu için scroll_credit + card aktif. Diğerleri schema seviyesinde tanımlı, V2+ ile devreye girer."
        },
        "type_reason": {
          "type": "string",
          "description": "Debug-readable string. Örn: 'tracker_velocity_y=-4.2 + duration>15s + stable=true → scroll_credit'. Faz 1 madde 8."
        },
        "bbox": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] pixel cinsinden, video orijinal çözünürlüğünde"
        },
        "text": {"type": "string"},
        "secondary_text": {
          "type": ["string", "null"],
          "description": "D-split sonucu sağ kolon. Null → split yapılmadı / scroll değil"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "low_confidence": {
          "type": "boolean",
          "default": false,
          "description": "Tip-spesifik eşiğin altında mı? Faz 5 madde 7."
        },
        "tracker_id": {"type": ["integer", "null"]},
        "stability": {
          "type": "string",
          "enum": ["static", "scroll", "ephemeral"]
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Bu event boyunca kaç frame'de görüldü"
        },
        "lines": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "confidence": {"type": "number"},
              "bbox": {"type": "array", "items": {"type": "number"}}
            }
          },
          "description": "Scroll event'lerde alt-satırlar. Card event'lerde null."
        },
        "paired_role_name": {
          "type": ["object", "null"],
          "properties": {
            "role": {"type": "string"},
            "name": {"type": "string"}
          },
          "description": "D-split sonucu. Yoksa null."
        }
      }
    }
  }
}
