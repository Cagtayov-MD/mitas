# =====================================================================
# MITAS Konsey — API Anahtarları (TEK MERKEZ ŞABLONU)
# =====================================================================
# Bu dosya ŞABLON. Gerçek anahtarlar .env dosyasına yazılır (git'e gitmez).
#
# KULLANIM: .env'de anahtarı dolu olan üye konseye otomatik katılır,
# boş olan atlanır. Kod değişikliği GEREKMEZ.
#
# Anahtar ekledikten sonra yeniden başlatma da gerekmez — server her
# ask_council çağrısında .env'i tazeler.
# =====================================================================

# --- Google Gemini -----------------------------------------------------
GEMINI_API_KEY=

# --- Alibaba Qwen (DashScope, OpenAI-uyumlu) ---------------------------
# Varsayılan model: qwen3.7-max
# Farklı model için alttaki satırı aç: örn. QWEN_MODEL=qwen3.8-max
# Bölgeye göre uç değişebilir: QWEN_BASE_URL ile override edilebilir.
QWEN_API_KEY=
#QWEN_MODEL=
#QWEN_BASE_URL=

# --- Zhipu GLM ---------------------------------------------------------
# Varsayılan model: glm-5.2
GLM_API_KEY=
#GLM_MODEL=
#GLM_BASE_URL=

# --- OpenAI GPT --------------------------------------------------------
OPENAI_API_KEY=

# --- Moonshot Kimi -----------------------------------------------------
# Varsayılan model: kimi-k3, uç: https://api.moonshot.ai/v1
KIMI_API_KEY=
#KIMI_MODEL=
#KIMI_BASE_URL=

# --- NVIDIA Build (NIM, nvapi- anahtarı) -------------------------------
# TEK anahtar İKİ üyeyi birden açar: nemotron (nvidia/nemotron-3-ultra-550b-a55b)
# + minimax (minimaxai/minimax-m3). Uç: https://integrate.api.nvidia.com/v1
# (OpenAI-uyumlu; katalogdaki HER modele aynı anahtarla erişilir).
# Kota: ücretsiz katman, ~40 istek/dk/model (rate-limit tabanlı, kredi yok).
NVIDIA_API_KEY=
#NVIDIA_MODEL=       # nemotron üyesinin modelini değiştirir
#MINIMAX_MODEL=      # minimax üyesinin modelini değiştirir
#NVIDIA_BASE_URL=
