# Bu dosyayı .env olarak kopyala, gerçek key'leri oraya yaz.
# .env asla git'e commit edilmez (.gitignore'da tanımlı).

# Şu an aktif olan tek üye:
GEMINI_API_KEY=

# İleride key eklendiğinde otomatik devreye girecekler:
QWEN_API_KEY=
# QWEN_BASE_URL=            # gerekirse override et, providers/qwen.py'deki notu oku

GLM_API_KEY=
# GLM_BASE_URL=             # gerekirse override et, providers/glm.py'deki notu oku

OPENAI_API_KEY=
