# ATLAS Linux ortam dosyasi - systemd EnvironmentFile + `set -a; source atlas.env; set +a`
# chmod 600 (icinde sir olabilir). Pydantic-settings prefix'i ATLAS_ (src/atlas/config/settings.py).
# MITAS mitas.env sablonu (E:\MITAS\linux\mitas.env) - 00_ATLAS_TASIMA_PLANI.md §7.

# -- Cekirdek (settings.py'nin zaten okudugu) --------------------------------
ATLAS_PROJECT_ROOT=/opt/atlas
ATLAS_DATA_ROOT=/opt/atlas/data
ATLAS_DB_PATH=/opt/atlas/atlas.db
ATLAS_DEFAULT_PROFILE=config/profiles/trt_haber.v1.yaml
# ATLAS_HF_TOKEN=            # yalniz pyannote TAZE indirme gerekirse

# -- Yeni env-tohumlari (Faz C kod fix'leriyle eklenir) ----------------------
ATLAS_FFMPEG=/usr/bin/ffmpeg           # K-A6: fark cikarsa /opt/atlas/tools/ffmpeg (8.x statik)
ATLAS_FFPROBE=/usr/bin/ffprobe
ATLAS_OLLAMA_URL=http://127.0.0.1:11435   # K-A2: ATLAS'in KENDI ollama'si (MITAS 11434 ile CAKISMAZ)
ATLAS_OCR_ENGINE=paddle                   # kj_ocr.py: oneocr yoksa (Linux'ta HER ZAMAN) bu
                                           # motor devreye girer. K1-GATE (gercek video ile
                                           # OneOCR-referans karsilastirma) HENUZ OLCULMEDI -
                                           # bkz UYGULAMA_LOG.md Faz F. "oneocr-bridge" KOPRUSU
                                           # (Windows-host HTTP servisi) BU OTURUMDA KURULMADI -
                                           # yalniz dogrudan Paddle-ikamesi (K1-GATE oncesi).
# ATLAS_ONEOCR_BRIDGE=http://<win-host>:8791   # Koprü kurulursa (ayrica implementasyon gerekir)

# -- HF / model cache (hepsi F-ici) ------------------------------------------
HF_HOME=/opt/atlas/hf-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# -- ollama servis ortami (systemd unit'e de yazilir) ------------------------
OLLAMA_HOST=127.0.0.1:11435
OLLAMA_MODELS=/opt/atlas/models/ollama

# -- SIRLAR - Linux'ta gercek degerleriyle DOLDUR (git'e commit ETME) -------
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# ATLAS_TMDB=...
