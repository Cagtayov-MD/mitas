[Unit]
Description=ATLAS Semantic Search Server (:8789, izole)
After=network-online.target atlas-ollama.service
Wants=network-online.target
Requires=atlas-ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/atlas
EnvironmentFile=/opt/atlas/atlas.env
ExecStart=/opt/atlas/venvs/core/bin/python /opt/atlas/scripts/search_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
