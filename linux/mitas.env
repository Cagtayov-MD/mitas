# MITAS Linux ortam dosyası — systemd EnvironmentFile + `set -a; source mitas.env; set +a`
# Windows'ta "User env"di; Linux'ta burada. chmod 600 (içinde anahtarlar var).
# ⚠ Sırlar (API anahtarları) aşağıda PLACEHOLDER — Linux'ta gerçek değerleriyle doldur
#   (Windows User env'den: [Environment]::GetEnvironmentVariables('User') ile aynı değerler).

# ── Yollar ────────────────────────────────────────────────────────────────────
MITAS_PROJECT_ROOT=/opt/mitas
MITAS_FFMPEG=/usr/bin/ffmpeg
MITAS_FFPROBE=/usr/bin/ffprobe
MITAS_PDF_PYTHON=/opt/mitas/venvs/asr/bin/python
MITAS_PDFMITAS_DIR=/opt/mitas/OCR-worktree/pdf-mitas
MITAS_FLOW_STAGING=/opt/mitas/cache/staging
MITAS_WEB_CACHE_DIR=/opt/mitas/cache/web
MITAS_DUCKDB_CACHE=/opt/mitas/cache/duckdb
MITAS_SERILER_ROOT=/data/mitas/seriler
MITAS_MSFONT_DIR=/usr/share/fonts/truetype/msttcorefonts

# ── DuckDB'ler (KB / IMDB / Wikidata) — Linux mount yollarına ayarla ───────────
MITAS_KB_DUCKDB=/data/mitas/MitaData/mitas.duckdb
MITAS_IMDB_DUCKDB=/data/mitas/IMDB/db/imdb.duckdb
MITAS_WIKIDATA_DUCKDB=/data/mitas/MitaData/mitas.duckdb

# ── OCR modelleri ─────────────────────────────────────────────────────────────
MITAS_PADDLEOCR_TEXT_DET_MODEL_DIR=/opt/mitas/models/ocr/paddle/det
MITAS_PADDLEOCR_TEXT_REC_MODEL_DIR=/opt/mitas/models/ocr/paddle/rec
MITAS_JENERIK_PADDLE_MODEL_ROOT=/opt/mitas/models/ocr/paddle/official_models
MITAS_TESSERACT_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
# OneOCR ikamesi (bkz. 08): geçişte oneocr, K1-GATE sonrası glm|paddle
MITAS_OCR_ENGINE=oneocr
# MITAS_ONEOCR_BRIDGE=http://<win-host>:8790   # Faz 0 köprüsü kullanılırsa

# JENERİK-V5 (2026-07-23, %92 kampanyası — Çağatay: "artık aktif jenerik başlangıç stratejimiz bu")
# tespit_v5: 110-film GT %93.6 simetrik / %96.4 üretim / kredisiz 29/29. Kapat: =0 (eski akış birebir).
# ŞABLON-DRIFT FIX (2026-07-30): bu iki satır kök mitas.env'de vardı ama şablonda YOKTU —
# taze re-provision v5'i sessizce kapatıyordu (kod default "0"). Kök env ile hizalandı.
MITAS_JENERIK_V5=1
# Güvenlik payı (kare): erken zararsız, geç cast kaybettirir (asimetri politikası).
MITAS_JENERIK_V5_PAD=10

# ── LLM / ollama ──────────────────────────────────────────────────────────────
MITAS_OLLAMA_URL=http://127.0.0.1:11434
MITAS_OLLAMA_KEEP_ALIVE=15m

# ── HF / model cache (veri diskine — D'yi/kökü doldurmamak için) ───────────────
HF_HOME=/data/mitas/models/hf_cache

# ── start_mitas.ps1 üretim default'ları (BİREBİR ayna — kodda da var) ──────────
MITAS_QC2=1
MITAS_QC2_WEB=1
MITAS_QC_BLOCK=1
MITAS_SES_DIL_KONTROL=0
MITAS_QC_DIRECTOR_ANCHOR=1
MITAS_CREDIT_DETECT=1
MITAS_KB_CAST_ADD=1
MITAS_GEMMA_FULLCOVER=1
MITAS_SHADOW_VL=0
MITAS_JENERIK_PARALLEL_DEBUG=0
MITAS_OCR_GLM_CONSENSUS=0
MITAS_FRAME_DEDUP=0
MITAS_QC_OTORITE_AUDIT=1
MITAS_QC_FLOORFILL_OCRGUARD=1
MITAS_QC_FUZZY_DEDUP=1
MITAS_QC_OTORITE_ROUTE=1
MITAS_QC_PRODUCER_STRONGID=1
MITAS_XMLCAST_GATE_RELAX=1
MITAS_POSTER_VER_GATE=1
MITAS_LID_TR_VETO=1
MITAS_GARBLE_NGRAM=1
MITAS_GARBLE_NGRAM_ROUTE=0
MITAS_CAST_OCR_KEEP=1
MITAS_CAST_CAP=18
MITAS_QC_NONCAST_FILTER=1
MITAS_QC_ROLE_FILTER=1
MITAS_DIRECTOR_RESCUE=1
MITAS_OZET_GEMINI=1
MITAS_OZET_CLOUD=1
MITAS_FLOW_PREFETCH=1

# ── SIRLAR — Linux'ta gerçek değerleriyle DOLDUR (git'e commit ETME) ───────────
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# MITAS_TMDB=...
# MITAS_DEEPSEEK=...
# MITAS_GEMINI=...
# FIGO (2026-07-30): kredisizde CV devralmaz — FIGO son söz (kök mitas.env ile hizalı).
MITAS_JENERIK_METIN_KAPI=1
