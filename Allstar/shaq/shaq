#!/usr/bin/env bash
# Shaq kendi çalışma zamanını bulur; çağıran Python sürümünü bilmez.
set -euo pipefail
K="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$K/venv/bin/python" ]; then
  echo "Shaq venv bulunamadi; once $K/venv_kur.sh calistir." >&2
  exit 127
fi
exec "$K/venv/bin/python" "$K/main.py" "$@"
