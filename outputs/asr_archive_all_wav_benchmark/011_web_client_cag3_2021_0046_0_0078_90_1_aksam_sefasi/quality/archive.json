      "no_speech_prob": 0.1522216796875,
      "source_chunk_index": 12
    },
    {
      "start": 2128.8,
      "end": 2131.54,
      "text": "Yarı söyleme",
      "speaker": null,
      "flags": [
        "low_logprob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.8342634098870414,
      "no_speech_prob": 0.09442138671875,
      "source_chunk_index": 13
    },
    {
      "start": 2591.9,
      "end": 2594.8,
      "text": "Bravo İlker",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11149088215703766,
      "no_speech_prob": 0.1971435546875,
      "source_chunk_index": 14
    },
    {
      "start": 2594.8,
      "end": 2596.8,
      "text": "Seni uğurlamıyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11149088215703766,
      "no_speech_prob": 0.1971435546875,
      "source_chunk_index": 14
    },
    {
      "start": 2596.8,
      "end": 2601.4,
      "text": "Diğer arkadaşlarımı da alkışlarınızla güçlü alkışlarınızla bir kez daha sahneye davet etmek istiyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11149088215703766,
      "no_speech_prob": 0.1971435546875,
      "source_chunk_index": 14
    },
    {
      "start": 2601.4,
      "end": 2602.86,
      "text": "Hep beraber",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11149088215703766,
      "no_speech_prob": 0.1971435546875,
      "source_chunk_index": 14
    },
    {
      "start": 2604.87,
      "end": 2606.91,
      "text": "Hareketlenelim hatta coşalım diyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.254231758415699,
      "no_speech_prob": 0.09466552734375,
      "source_chunk_index": 15
    },
    {
      "start": 2607.29,
      "end": 2608.33,
      "text": "Bize eşlik eder misiniz?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.254231758415699,
      "no_speech_prob": 0.09466552734375,
      "source_chunk_index": 15
    },
    {
      "start": 2657.575,
      "end": 2661.095,
      "text": "Sen de benim gibi sevdalı mısın vay vay",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22511573632558188,
      "no_speech_prob": 0.36279296875,
      "source_chunk_index": 17
    },
    {
      "start": 2661.095,
      "end": 2663.115,
      "text": "Şeker yemesin vay vay",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22511573632558188,
      "no_speech_prob": 0.36279296875,
      "source_chunk_index": 17
    },
    {
      "start": 2663.115,
      "end": 2664.995,
      "text": "Kaymakamısın vay vay",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22511573632558188,
      "no_speech_prob": 0.36279296875,
      "source_chunk_index": 17
    },
    {
      "start": 2664.995,
      "end": 2668.935,
      "text": "Yoksa sen de benim gibi sevdalı mısın vay vay",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22511573632558188,
      "no_speech_prob": 0.36279296875,
      "source_chunk_index": 17
    },
    {
      "start": 2743.0,
      "end": 2748.9,
      "text": "Kısacık bir reklam arasından yeniden sizlerleyiz.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2978515671566129,
      "no_speech_prob": 0.228759765625,
      "source_chunk_index": 18
    },
    {
      "start": 2749.0,
      "end": 2750.36,
      "text": "Sakın bizden bir yere ayrılmayın.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2978515671566129,
      "no_speech_prob": 0.228759765625,
      "source_chunk_index": 18
    },
    {
      "start": 3105.5,
      "end": 3118.5,
      "text": "Teşekkür ederim.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4020647406578064,
      "no_speech_prob": 0.6005859375,
      "source_chunk_index": 19
    },
    {
      "start": 3118.5,
      "end": 3126.48,
      "text": "Bu kadar zamandır belki de var olmasında sizlerin bu kadar benimsemesindeki en büyük sebep bizlerin arasındaki dostluk belki de.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.06030273584959408,
      "no_speech_prob": 0.07354736328125,
      "source_chunk_index": 20
    },
    {
      "start": 3126.56,
      "end": 3131.52,
      "text": "Bu sıcaklık kendimizi evimizde hissettiriyor ve aynısını da size geçirdiğimizi düşünüyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.06030273584959408,
      "no_speech_prob": 0.07354736328125,
      "source_chunk_index": 20
    },
    {
      "start": 3131.9,
      "end": 3134.5,
      "text": "Sanki evimizin salonundayız ve meşk ediyor gibi hissediyoruz.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.06030273584959408,
      "no_speech_prob": 0.07354736328125,
      "source_chunk_index": 20
    },
    {
      "start": 3134.6,
      "end": 3135.9,
      "text": "Bilmiyorum size nasıl yansıyor.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.06030273584959408,
      "no_speech_prob": 0.07354736328125,
      "source_chunk_index": 20
    },
    {
      "start": 3140.0,
      "end": 3145.32,
      "text": "Benim kıymetli arkadaşım Volkan, Teknik Üniversite Konservatuvar'dan sınıf arkadaşım.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3145.32,
      "end": 3148.84,
      "text": "Korhan'la zaten yılını söylemeyelim, yıllardır beraberiz.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3148.9,
      "end": 3150.82,
      "text": "Bütün müzisyen arkadaşlarımla keza öyle.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3151.28,
      "end": 3153.32,
      "text": "Şimdi ben de onların şarkı söyleyeceğini duydum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3153.44,
      "end": 3155.38,
      "text": "Tabii ki kambersiz düğün olur mu?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3155.98,
      "end": 3157.46,
      "text": "Ben de söylemek istiyorum dedim.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3158.84,
      "end": 3160.74,
      "text": "Hem de hangi şarkıyı biliyor musunuz?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12703519533662236,
      "no_speech_prob": 0.07672119140625,
      "source_chunk_index": 21
    },
    {
      "start": 3160.9,
      "end": 3172.14,
      "text": "Unuttum seni, unuttum seni.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.28816104852236235,
      "no_speech_prob": 0.5693359375,
      "source_chunk_index": 22
    },
    {
      "start": 3496.475,
      "end": 3502.995,
      "text": "Nasıl keyifleriniz demenin vakti geldi.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2471354126930237,
      "no_speech_prob": 0.1822509765625,
      "source_chunk_index": 24
    },
    {
      "start": 3506.075,
      "end": 3517.335,
      "text": "Ekran başındaki akşam sefası dostlarımız sizlerden de bu alkışları alıyoruzdur diye ümit ediyorum ve bir kez daha huzurlarınıza Ömer Faruk Özcan'ı davet ediyorum. Güçlü alkışlarınızla lütfen.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.0753968268159836,
      "no_speech_prob": 0.056549072265625,
      "source_chunk_index": 25
    },
    {
      "start": 3552.5,
      "end": 3562.46,
      "text": "Aşka merakım ezelde, sen güzel bir bahaneydin.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.35320723056793213,
      "no_speech_prob": 0.5185546875,
      "source_chunk_index": 26
    },
    {
      "start": 3566.8,
      "end": 3570.72,
      "text": "Sen güzel bir bahaneydin.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4617187321186066,
      "no_speech_prob": 0.052703857421875,
      "source_chunk_index": 28
    },
    {
      "start": 3572.75,
      "end": 3576.55,
      "text": "MAHRUM DEĞİK",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.3942057391007741,
      "no_speech_prob": 0.7470703125,
      "source_chunk_index": 29
    },
    {
      "start": 3576.6,
      "end": 3585.5,
      "text": "Güzelden ben sende sevmeyi sevdim mahrum değildim",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.3375822337050187,
      "no_speech_prob": 0.60986328125,
      "source_chunk_index": 30
    },
    {
      "start": 3585.75,
      "end": 3591.13,
      "text": "Ben Sende Sevmeyi Sevdim",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.3410866585644809,
      "no_speech_prob": 0.468505859375,
      "source_chunk_index": 31
    },
    {
      "start": 3594.075,
      "end": 3605.335,
      "text": "Bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum, bulamıyorum, kendimi kandırıyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.10769127257939043,
      "no_speech_prob": 0.14501953125,
      "source_chunk_index": 32
    },
    {
      "start": 3605.9,
      "end": 3617.78,
      "text": "Aslında ben sende yaradanı sevdim, bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.1777343764901161,
      "no_speech_prob": 0.309814453125,
      "source_chunk_index": 33
    },
    {
      "start": 3617.875,
      "end": 3627.875,
      "text": "bulamıyorum kendimi kandırıyorum aslında ben sende yaradanı sevdim",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.363671875,
      "no_speech_prob": 0.3037109375,
      "source_chunk_index": 34
    },
    {
      "start": 3669.05,
      "end": 3676.15,
      "text": "Ben senin sevgini sevdim, sana sundum gani gani.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.21237664630538539,
      "no_speech_prob": 0.66552734375,
      "source_chunk_index": 36
    },
    {
      "start": 3676.45,
      "end": 3681.15,
      "text": "Ben sende sevgiyi sevdim",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2547940340909091,
      "no_speech_prob": 0.26513671875,
      "source_chunk_index": 37
    },
    {
      "start": 3684.1,
      "end": 3695.3,
      "text": "Bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum, bulamıyorum, kendimi kandırıyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12735721777225362,
      "no_speech_prob": 0.09918212890625,
      "source_chunk_index": 38
    },
    {
      "start": 3696.95,
      "end": 3705.09,
      "text": "Ben sende yaradanı sevdim, bir daha sevemiyorum, sevemiyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.19086370865503946,
      "no_speech_prob": 0.2086181640625,
      "source_chunk_index": 39
    },
    {
      "start": 3705.77,
      "end": 3709.95,
      "text": "Bahane bulamıyorum, bulamıyorum kendimi.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.19086370865503946,
      "no_speech_prob": 0.2086181640625,
      "source_chunk_index": 39
    },
    {
      "start": 3710.525,
      "end": 3718.165,
      "text": "Kandırıyorum aslında ben sende yaradanı sevdim",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.33567707538604735,
      "no_speech_prob": 0.2578125,
      "source_chunk_index": 40
    },
    {
      "start": 3889.95,
      "end": 3902.33,
      "text": "Söyle canım sevgilim, hayat bize oyun oynuyor olabilir mi?",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.2951388888888889,
      "no_speech_prob": 0.52783203125,
      "source_chunk_index": 41
    },
    {
      "start": 4240.55,
      "end": 4244.91,
      "text": "Boşa geçmiş ömre yaşam denir",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4399305476082696,
      "no_speech_prob": 0.57958984375,
      "source_chunk_index": 42
    },
    {
      "start": 4244.91,
      "end": 4249.03,
      "text": "Yaz tahtaya bir daha",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4399305476082696,
      "no_speech_prob": 0.57958984375,
      "source_chunk_index": 42
    },
    {
      "start": 4249.03,
      "end": 4251.71,
      "text": "Dün dikdiri kitabı",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4399305476082696,
      "no_speech_prob": 0.57958984375,
      "source_chunk_index": 42
    },
    {
      "start": 4251.71,
      "end": 4254.41,
      "text": "Sarı çizmeli Mehmet Ağa",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4399305476082696,
      "no_speech_prob": 0.57958984375,
      "source_chunk_index": 42
    },
    {
      "start": 4331.4,
      "end": 4337.54,
      "text": "Sarı çizmeli Mehmet Ağa bir gün öder hesabı",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.43834460426021266,
      "no_speech_prob": 0.7197265625,
      "source_chunk_index": 43
    },
    {
      "start": 4337.54,
      "end": 4342.58,
      "text": "Yaz tahtaya bir dana tık defteri kitabı",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.43834460426021266,
      "no_speech_prob": 0.7197265625,
      "source_chunk_index": 43
    },
    {
      "start": 4342.8,
      "end": 4347.32,
      "text": "Sarı çizmeli Mehmet Ağa, bir gün öder hesap.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3552827380952381,
      "no_speech_prob": 0.12225341796875,
      "source_chunk_index": 44
    },
    {
      "start": 4717.55,
      "end": 4722.99,
      "text": "Çünkü yıllar öncesinde kalan aşkımız bir masal.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.24956596394379935,
      "no_speech_prob": 0.5546875,
      "source_chunk_index": 47
    },
    {
      "start": 4723.0,
      "end": 4729.04,
      "text": "Tanrıç bir tanem, düş yerine gerçekmiş yaşanım, sevmek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.30146059005156806,
      "no_speech_prob": 0.2783203125,
      "source_chunk_index": 48
    },
    {
      "start": 4729.35,
      "end": 4735.07,
      "text": "Eskidenmiş güzelim sanki yıllar öncesinde kalan",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.17982701265386172,
      "no_speech_prob": 0.2392578125,
      "source_chunk_index": 49
    },
    {
      "start": 4735.07,
      "end": 4738.45,
      "text": "Aşkımız bir masal",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.17982701265386172,
      "no_speech_prob": 0.2392578125,
      "source_chunk_index": 49
    },
    {
      "start": 4745.2,
      "end": 4750.08,
      "text": "Bizim için geç artık, çok geç artık sana dönmek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.30911457935969033,
      "no_speech_prob": 0.378173828125,
      "source_chunk_index": 51
    },
    {
      "start": 4750.4,
      "end": 4753.14,
      "text": "Hadi giderken bana",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.4349888563156128,
      "no_speech_prob": 0.53515625,
      "source_chunk_index": 52
    },
    {
      "start": 4818.0,
      "end": 4827.12,
      "text": "Bak yeniden belki de sevinçle koçaklaşıp başlarız kaldığımız yerden.",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
      "avg_logprob": -0.2126562452316284,
      "no_speech_prob": 0.477294921875,
      "source_chunk_index": 54
    },
    {
      "start": 4828.25,
      "end": 4831.59,
      "text": "denen yerden başlamak",
      "speaker": null,
      "flags": [
        "high_no_speech_prob",
        "low_confidence"
      ],
      "language": "tr",
