      "text": "Seni uğurlamıyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.14284619805859586,
      "no_speech_prob": 0.0,
      "source_chunk_index": 14
    },
    {
      "start": 2596.8,
      "end": 2598.62,
      "text": "Diğer arkadaşlarımı da alkışlarınızla",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.14284619805859586,
      "no_speech_prob": 0.0,
      "source_chunk_index": 14
    },
    {
      "start": 2598.62,
      "end": 2601.4,
      "text": "Güçlü alkışlarınızı bir kez daha sahneye davet etmek istiyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.14284619805859586,
      "no_speech_prob": 0.0,
      "source_chunk_index": 14
    },
    {
      "start": 2601.4,
      "end": 2602.86,
      "text": "Hep beraber",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.14284619805859586,
      "no_speech_prob": 0.0,
      "source_chunk_index": 14
    },
    {
      "start": 2604.05,
      "end": 2609.05,
      "text": "Hareketlenelim hatta coşalım diyorum, bize eşlik eder misiniz?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3835565419424148,
      "no_speech_prob": 0.0,
      "source_chunk_index": 15
    },
    {
      "start": 2657.575,
      "end": 2660.835,
      "text": "Sen de benim gibi sevdalı mısın vay?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.39756944168497016,
      "no_speech_prob": 0.0,
      "source_chunk_index": 17
    },
    {
      "start": 2661.175,
      "end": 2663.095,
      "text": "Şekerli misin vay vay?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.39756944168497016,
      "no_speech_prob": 0.0,
      "source_chunk_index": 17
    },
    {
      "start": 2663.235,
      "end": 2664.935,
      "text": "Kaymak kapısın vay vay?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.39756944168497016,
      "no_speech_prob": 0.0,
      "source_chunk_index": 17
    },
    {
      "start": 2665.135,
      "end": 2668.535,
      "text": "Yoksa sen de benim gibi sevdalı mısın vay?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.39756944168497016,
      "no_speech_prob": 0.0,
      "source_chunk_index": 17
    },
    {
      "start": 2743.0,
      "end": 2750.38,
      "text": "Kısacık bir reklam arasımlarından yeniden sizlerleyiz sakın bizden bir ara ayrılmayın.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2998992031620395,
      "no_speech_prob": 0.0,
      "source_chunk_index": 18
    },
    {
      "start": 3105.5,
      "end": 3118.5,
      "text": "Teşekkürler.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.7773437670298985,
      "no_speech_prob": 0.0,
      "source_chunk_index": 19
    },
    {
      "start": 3118.5,
      "end": 3126.48,
      "text": "Dar zamandır belki de var olmasında sizlerin bu kadar benimsemesindeki en büyük sebep bizlerin arasındaki dostluk belki de.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.05912829025795585,
      "no_speech_prob": 0.0,
      "source_chunk_index": 20
    },
    {
      "start": 3126.54,
      "end": 3131.5,
      "text": "Bu sıcaklık kendimizi evimizde hissettiriyor ve aynısını da size geçirdiğimizi düşünüyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.05912829025795585,
      "no_speech_prob": 0.0,
      "source_chunk_index": 20
    },
    {
      "start": 3131.5,
      "end": 3134.5,
      "text": "Sanki evimizin salonundayız ve meşk ediyor gibi hissediyoruz.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.05912829025795585,
      "no_speech_prob": 0.0,
      "source_chunk_index": 20
    },
    {
      "start": 3134.6,
      "end": 3135.9,
      "text": "Bilmiyorum size nasıl yansıyor.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.05912829025795585,
      "no_speech_prob": 0.0,
      "source_chunk_index": 20
    },
    {
      "start": 3140.0,
      "end": 3145.32,
      "text": "Benim kıymetli arkadaşım Volkan, Teknik Üniversite Konservatuarı'ndan sınıf arkadaşım.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3145.42,
      "end": 3148.82,
      "text": "Korhan'la zaten yılını söylemeyelim, yıllardır beraberiz.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3148.9,
      "end": 3150.8,
      "text": "Bütün müzisyen arkadaşlarımla keza öyle.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3151.26,
      "end": 3153.32,
      "text": "Şimdi ben de onların şarkı söyleyeceğini duydum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3153.42,
      "end": 3155.38,
      "text": "Tabii ki kambersiz düğün olur mu?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3155.96,
      "end": 3157.44,
      "text": "Ben de söylemek istiyorum dedim.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3158.38,
      "end": 3160.72,
      "text": "Hem de hangi şarkıyı biliyor musunuz?",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.12832030716041723,
      "no_speech_prob": 0.0,
      "source_chunk_index": 21
    },
    {
      "start": 3160.9,
      "end": 3172.22,
      "text": "Unutamam seni, unutamam seni",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3180042722008445,
      "no_speech_prob": 0.0,
      "source_chunk_index": 22
    },
    {
      "start": 3496.475,
      "end": 3502.995,
      "text": "Nasıl keyifliyiniz demenin vakti geldi.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.28808592818677425,
      "no_speech_prob": 0.0,
      "source_chunk_index": 24
    },
    {
      "start": 3506.075,
      "end": 3516.175,
      "text": "Ekran başındaki akşam sefası dostlarımız sizlerden de bu alkışları alıyoruzdur diye ümit ediyorum ve bir kez daha huzurlarınıza Ömer Faruk Özcan'ı davet ediyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11039663461538461,
      "no_speech_prob": 0.0,
      "source_chunk_index": 25
    },
    {
      "start": 3516.295,
      "end": 3517.335,
      "text": "Güçlü alkışlarınızla lütfen.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.11039663461538461,
      "no_speech_prob": 0.0,
      "source_chunk_index": 25
    },
    {
      "start": 3552.5,
      "end": 3564.6,
      "text": "Aşka merakım ezelde sen güzel bir bahaneydin aşka merakım.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2579823421395343,
      "no_speech_prob": 0.0,
      "source_chunk_index": 26
    },
    {
      "start": 3566.8,
      "end": 3571.94,
      "text": "Sen güzel bir bahaneydin.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4705255681818182,
      "no_speech_prob": 0.0,
      "source_chunk_index": 28
    },
    {
      "start": 3572.75,
      "end": 3576.57,
      "text": "Mahrum Bey'in",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3908420138888889,
      "no_speech_prob": 0.0,
      "source_chunk_index": 29
    },
    {
      "start": 3576.6,
      "end": 3585.5,
      "text": "Güzel de ben sende sevmeyi sevdim, mahrum değildim.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.31101189908527194,
      "no_speech_prob": 0.0,
      "source_chunk_index": 30
    },
    {
      "start": 3585.75,
      "end": 3591.09,
      "text": "Ben sen de sevmeyi sevdim.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3818359250823657,
      "no_speech_prob": 0.0,
      "source_chunk_index": 31
    },
    {
      "start": 3594.075,
      "end": 3598.735,
      "text": "Bir daha sevemiyorum, sevemiyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.1584635481238365,
      "no_speech_prob": 0.0,
      "source_chunk_index": 32
    },
    {
      "start": 3598.735,
      "end": 3602.875,
      "text": "Bahane bulamıyorum, bulamıyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.1584635481238365,
      "no_speech_prob": 0.0,
      "source_chunk_index": 32
    },
    {
      "start": 3602.875,
      "end": 3605.335,
      "text": "Kendimi kandırıyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.1584635481238365,
      "no_speech_prob": 0.0,
      "source_chunk_index": 32
    },
    {
      "start": 3605.9,
      "end": 3617.78,
      "text": "Aslında ben sende yaradanı sevdim, bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.19934895386298498,
      "no_speech_prob": 0.0,
      "source_chunk_index": 33
    },
    {
      "start": 3669.05,
      "end": 3676.15,
      "text": "Ben senin sevgini sevdim, sana sundum gani gani.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.21895559681089302,
      "no_speech_prob": 0.0,
      "source_chunk_index": 36
    },
    {
      "start": 3684.1,
      "end": 3695.3,
      "text": "Bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum, bulamıyorum, kendimi kandırıyorum.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.13402478037209348,
      "no_speech_prob": 0.0,
      "source_chunk_index": 38
    },
    {
      "start": 3696.95,
      "end": 3710.525,
      "text": "Ben sende yaradanı sevdim, bir daha sevemiyorum, sevemiyorum, bahane bulamıyorum, bulamıyorum, kendime...",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.25401786054883685,
      "no_speech_prob": 0.0,
      "source_chunk_index": 39
    },
    {
      "start": 3710.525,
      "end": 3712.045,
      "text": "Kandırıyorum",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.47316574791203375,
      "no_speech_prob": 0.0,
      "source_chunk_index": 40
    },
    {
      "start": 3712.045,
      "end": 3713.305,
      "text": "Aslında",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.47316574791203375,
      "no_speech_prob": 0.0,
      "source_chunk_index": 40
    },
    {
      "start": 3713.305,
      "end": 3715.665,
      "text": "Ben sende",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.47316574791203375,
      "no_speech_prob": 0.0,
      "source_chunk_index": 40
    },
    {
      "start": 3715.665,
      "end": 3717.925,
      "text": "Yaradanı sevdim",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.47316574791203375,
      "no_speech_prob": 0.0,
      "source_chunk_index": 40
    },
    {
      "start": 3889.95,
      "end": 3901.37,
      "text": "Güle canım sevgilim hayat bize oyun oynuyor olabilir.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4902343824505806,
      "no_speech_prob": 0.0,
      "source_chunk_index": 41
    },
    {
      "start": 4331.4,
      "end": 4337.4,
      "text": "kitabı sar çizmeli Mehmet Ağabey bir gün öder hesabı",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.5503048547884313,
      "no_speech_prob": 0.0,
      "source_chunk_index": 43
    },
    {
      "start": 4337.4,
      "end": 4342.4,
      "text": "yastak dayağı birden aldık defteri kitabı",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.5503048547884313,
      "no_speech_prob": 0.0,
      "source_chunk_index": 43
    },
    {
      "start": 4342.8,
      "end": 4347.32,
      "text": "Sarı çizmeli Mehmet Ağa, bir gün öden eser.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4657737981705439,
      "no_speech_prob": 0.0,
      "source_chunk_index": 44
    },
    {
      "start": 4717.55,
      "end": 4722.99,
      "text": "Çünkü yıllar öncesinde kalan aşkımız bir masa.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.16819852941176472,
      "no_speech_prob": 0.0,
      "source_chunk_index": 47
    },
    {
      "start": 4723.0,
      "end": 4729.02,
      "text": "Almış bir tanem düş yerine gerçekmiş yaşanım sevmek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.34827303886413574,
      "no_speech_prob": 0.0,
      "source_chunk_index": 48
    },
    {
      "start": 4729.35,
      "end": 4734.99,
      "text": "Eskidenmiş güzelim sanki yıllar öncesinde kalan",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22419085513268197,
      "no_speech_prob": 0.0,
      "source_chunk_index": 49
    },
    {
      "start": 4734.99,
      "end": 4738.45,
      "text": "Aşkımız bir masal",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.22419085513268197,
      "no_speech_prob": 0.0,
      "source_chunk_index": 49
    },
    {
      "start": 4745.2,
      "end": 4750.0,
      "text": "Bizim için geç artık, çok geç artık sana dönme.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.36901042064030964,
      "no_speech_prob": 0.0,
      "source_chunk_index": 51
    },
    {
      "start": 4750.4,
      "end": 4752.4,
      "text": "Hadi iyi gidelim",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.7944336012005806,
      "no_speech_prob": 0.0,
      "source_chunk_index": 52
    },
    {
      "start": 4818.0,
      "end": 4827.12,
      "text": "Bak yeniden belki de sevinçle kocaklaşıp başlarız kaldığımız yerden.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.23046874503294626,
      "no_speech_prob": 0.0,
      "source_chunk_index": 54
    },
    {
      "start": 4828.25,
      "end": 4834.39,
      "text": "Denen yerden başlamak ve gözlerini açmak yerden",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2565696049820293,
      "no_speech_prob": 0.0,
      "source_chunk_index": 55
    },
    {
      "start": 4834.39,
      "end": 4835.93,
      "text": "Belki de",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.2565696049820293,
      "no_speech_prob": 0.0,
      "source_chunk_index": 55
    },
    {
      "start": 4835.95,
      "end": 4838.93,
      "text": "Sevinçle kucaklaşık",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3018465909090909,
      "no_speech_prob": 0.0,
      "source_chunk_index": 56
    },
    {
      "start": 4844.9,
      "end": 4849.6,
      "text": "Bizim için geç artık, çık geç artık sana dönmek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.3877604047457377,
      "no_speech_prob": 0.0,
      "source_chunk_index": 58
    },
    {
      "start": 4851.3,
      "end": 4854.34,
      "text": "Bana demiştin ya sen",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4026692658662796,
      "no_speech_prob": 0.0,
      "source_chunk_index": 59
    },
    {
      "start": 4854.34,
      "end": 4857.14,
      "text": "Yolcu yolunda gerek",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4026692658662796,
      "no_speech_prob": 0.0,
      "source_chunk_index": 59
    },
    {
      "start": 4857.14,
      "end": 4861.46,
      "text": "Yolcu yolunda gerek",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.4026692658662796,
      "no_speech_prob": 0.0,
      "source_chunk_index": 59
    },
    {
      "start": 4866.3,
      "end": 4868.8,
      "text": "Kalk artık beni daha sevmek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.30972782642610613,
      "no_speech_prob": 0.0,
      "source_chunk_index": 60
    },
    {
      "start": 4869.58,
      "end": 4873.24,
      "text": "Hani giderken bana demiştin ya sen.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.30972782642610613,
      "no_speech_prob": 0.0,
      "source_chunk_index": 60
    },
    {
      "start": 4873.9,
      "end": 4875.78,
      "text": "Yolcu yolunda gerek.",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.30972782642610613,
      "no_speech_prob": 0.0,
      "source_chunk_index": 60
    },
    {
      "start": 4896.15,
      "end": 4900.87,
      "text": "Teşekkürler",
      "speaker": null,
      "flags": [],
      "language": "tr",
      "avg_logprob": -0.18950320818485358,
      "no_speech_prob": 0.0,
      "source_chunk_index": 62
    },
    {
      "start": 4900.87,
      "end": 4902.57,
      "text": "Hiç hız kesmeden devam ediyoruz",
      "speaker": null,
