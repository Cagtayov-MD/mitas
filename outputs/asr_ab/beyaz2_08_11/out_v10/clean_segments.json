      "flags": []
    },
    {
      "start": 31.0,
      "end": 33.0,
      "duration": 2.0,
      "text": "Adı değzi mi?",
      "language": "tr",
      "avg_logprob": -0.21984649802509107,
      "no_speech_prob": 0.0,
      "compression_ratio": 1.4532710280373833,
