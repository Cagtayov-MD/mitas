      "kept": true,
      "drop_reason": null,
      "flags": []
    },
    {
      "start": 33.0,
      "end": 39.8,
      "duration": 6.8,
      "text": "Kahvaltıda böbrek yağmış, bu bilgide… Daha da yediğim, kahvaltıda böbrek yağmış, evet…",
      "language": "tr",
      "avg_logprob": -0.21984649802509107,
      "no_speech_prob": 0.0,
