      ]
    },
    {
      "start": 57.0,
      "end": 63.64,
      "duration": 6.64,
      "text": "Yani acayip haftalar kendisini eve kapatmış ve baya yazdı yazdı yazdı.",
      "language": "tr",
      "avg_logprob": -0.12452290258334793,
