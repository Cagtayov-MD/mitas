    },
    {
      "start": 63.64,
      "end": 69.4,
      "duration": 5.76,
      "text": "Sonra bir gün bana mesaj attı. İşte öyle bir şarkı söyler misin senin karakterine uygun diye düşündük.",
      "language": "tr",
      "avg_logprob": -0.04873657179996371,
