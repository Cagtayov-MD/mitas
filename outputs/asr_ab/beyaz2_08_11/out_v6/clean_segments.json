    },
    {
      "start": 47.92,
      "end": 52.34,
      "duration": 4.42,
      "text": "Ozan bana, çok teşekkür ediyorum. Ozan bana göndermişti. Ben düşündüm o bir şaka.",
      "language": "tr",
      "avg_logprob": -0.12452290258334793,
