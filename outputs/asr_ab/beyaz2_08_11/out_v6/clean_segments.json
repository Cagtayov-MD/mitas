      "kept": true,
      "drop_reason": null,
      "flags": []
    },
    {
      "start": 15.0,
      "end": 26.54,
      "duration": 11.54,
      "text": "Evet, kimse anlamamıştı onu. Hiçbir veteriner anlamamıştı. Çok tüylü bir kediydi. Sonra dört tane yavru yaptılar.",
      "language": "tr",
      "avg_logprob": -0.18307782850175533,
      "no_speech_prob": 0.1861572265625,
      "compression_ratio": 1.4066985645933014,
