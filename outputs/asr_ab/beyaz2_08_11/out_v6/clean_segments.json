      "drop_reason": null,
      "flags": []
    },
    {
      "start": 39.4,
      "end": 44.0,
      "duration": 4.6,
      "text": "Valla konuşmadığın kadar varmış ben sana söyleyeyim. Evet konuşunca şey oldu yani.",
      "language": "tr",
      "avg_logprob": -0.12452290258334793,
