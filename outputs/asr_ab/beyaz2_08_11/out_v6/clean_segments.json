    {
      "start": 0.0,
      "end": 9.82,
      "duration": 9.82,
      "text": "Dişi bir kedi almışsın, başka bir dişi kediyi hamile bırakınca kendi kedinin erkek olduğunu anlamışsın.",
      "language": "tr",
      "avg_logprob": -0.15290178315980094,
      "no_speech_prob": 0.144287109375,
      "compression_ratio": 1.1855670103092784,
