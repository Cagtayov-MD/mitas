      ]
    },
    {
      "start": 44.18,
      "end": 46.1,
      "duration": 1.92,
      "text": "Sen mi söyledin filmdeki parçayı, yabancı parçayı?",
      "language": "tr",
      "avg_logprob": -0.12452290258334793,
