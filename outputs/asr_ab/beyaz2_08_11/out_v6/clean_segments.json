      "drop_reason": null,
      "flags": []
    },
    {
      "start": 27.0,
      "end": 28.78,
      "duration": 1.78,
      "text": "O gün ne adı seninkinin erkek oğlunu?",
      "language": "tr",
      "avg_logprob": -0.18307782850175533,
      "no_speech_prob": 0.1861572265625,
      "compression_ratio": 1.4066985645933014,
