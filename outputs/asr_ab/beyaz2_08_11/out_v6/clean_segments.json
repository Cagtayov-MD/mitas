      "chunk_end": 39.8,
      "source_vad_index": 5,
      "kept": true,
      "drop_reason": null,
      "flags": []
    },
    {
      "start": 29.04,
      "end": 30.56,
      "duration": 1.52,
      "text": "Evet, adama hala Daisy.",
      "language": "tr",
      "avg_logprob": -0.18307782850175533,
      "no_speech_prob": 0.1861572265625,
      "compression_ratio": 1.4066985645933014,
      "chunk_index": 1,
      "chunk_start": 15.0,
      "chunk_end": 39.8,
      "source_vad_index": 5,
      "kept": true,
      "drop_reason": null,
      "flags": []
    },
    {
      "start": 31.2,
      "end": 31.96,
      "duration": 0.76,
      "text": "Adı Daisy mi?",
      "language": "tr",
      "avg_logprob": -0.18307782850175533,
      "no_speech_prob": 0.1861572265625,
      "compression_ratio": 1.4066985645933014,
      "chunk_index": 1,
      "chunk_start": 15.0,
      "chunk_end": 39.8,
      "source_vad_index": 5,
      "kept": true,
      "drop_reason": null,
      "flags": []
    },
    {
      "start": 33.42,
      "end": 38.92,
      "duration": 5.5,
      "text": "Kahvaltıda böbrek gelmiş bu bilgide. Daha da ne diyeyim, kahvaltıda böbrek gelmiş.",
      "language": "tr",
      "avg_logprob": -0.18307782850175533,
      "no_speech_prob": 0.1861572265625,
      "compression_ratio": 1.4066985645933014,
