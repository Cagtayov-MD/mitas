      ]
    },
    {
      "start": 52.6,
      "end": 56.6,
      "duration": 4.0,
      "text": "Çünkü o bizim filmimizin senaristlerinden biri.",
      "language": "tr",
      "avg_logprob": -0.12452290258334793,
